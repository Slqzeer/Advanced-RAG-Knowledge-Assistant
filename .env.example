# Qdrant local (Docker Compose)
QDRANT_URL=http://localhost:6333
# Facultatif : clé d'authentification du serveur distant.
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# API FastAPI (étape 25). Obligatoire pour POST /query et POST /documents.
RAG_API_KEY=
RAG_API_PORT=8000

# Étape 26 — les URL localhost de l'hôte ne sont pas joignables telles quelles
# depuis un conteneur. Par défaut, l'image appelle OpenAI directement avec
# OPENAI_API_KEY. Pour une passerelle sur l'hôte, utiliser par exemple
# http://host.docker.internal:20128/v1 et ses identifiants propres.
DOCKER_GENERATION_MODEL=gpt-4o-mini
DOCKER_GENERATION_BASE_URL=
DOCKER_GENERATION_API_KEY=
DOCKER_EMBEDDING_BASE_URL=
DOCKER_EMBEDDING_API_KEY=
DOCKER_EMBEDDING_PROVIDER_MODEL=

# Embeddings (étape 05)
# Le cache est un fichier sqlite ; le supprimer ne fait que reperdre l'argent déjà dépensé.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CACHE_PATH=data/processed/embeddings.sqlite
OPENAI_API_KEY=
# Passerelle pour les embeddings, indépendante de celle de la génération. Vide : OpenAI en direct.
# Avec OmniRoute : EMBEDDING_BASE_URL=http://localhost:20128/v1, la clé OmniRoute, et
# EMBEDDING_PROVIDER_MODEL=github/text-embedding-3-small (l'identifiant côté passerelle ;
# le cache reste indexé sur EMBEDDING_MODEL). Vérifier d'abord que la route rend les
# vecteurs déjà en cache : uv run pytest -m requires_api tests/test_ingestion_embed.py
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER_MODEL=

# Découpage (étape 12)
# recursive | fixed | sentence | semantic — comparées à l'étape 12, table dans le README.
# sentence gagne : Recall@5 0.776 contre 0.713 pour recursive.
CHUNK_STRATEGY=sentence
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Génération (étape 08)
# temperature=0 est câblé dans le code : une réponse qui varie n'est pas évaluable.
GENERATION_MODEL=gpt-4o-mini

# Passerelle compatible OpenAI pour la génération uniquement. Vide = OpenAI en
# direct, le comportement d'origine. Avec OmniRoute : http://localhost:20128/v1,
# la clé du tableau de bord OmniRoute, et GENERATION_MODEL = un identifiant de
# modèle précis — pas « auto/… », dont le modèle peut changer d'un appel à l'autre
# et rendrait deux runs incomparables. OmniRoute choisit le fournisseur. Les embeddings
# ne la suivent pas : leur cache sqlite est indexé par nom de modèle seul.
GENERATION_BASE_URL=
GENERATION_API_KEY=

# Recherche (étapes 14-16)
# dense | lexical | hybrid — comparées à l'étape 16, table dans le README.
RETRIEVAL_MODE=dense
# Profondeur par branche avant fusion, et la constante k de RRF.
RETRIEVAL_CANDIDATES=50
RRF_K=60

# Reranking (étape 17)
# Vide = désactivé. flashrank | cohere — comparés à l'étape 17, table dans le README.
RERANK_MODEL=
# Profondeur du vivier envoyé au cross-encoder. Un reranker réordonne, il ne
# récupère pas : le rappel du vivier est son plafond.
RERANK_CANDIDATES=30
# ~34 Mo, téléchargé une fois dans data/processed/flashrank/.
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
# Requis uniquement pour --rerank cohere ; flashrank tourne en local sans clé.
COHERE_API_KEY=

# Transformations de requête (étapes 18-19)
# Vide = désactivé. rewrite | multi — comparées à l'étape 19, table dans le README.
QUERY_TRANSFORM=
# Nombre de requêtes utilisées par `multi`, la requête originale incluse.
# L'originale est toujours conservée : n=1 équivaut au comportement actuel.
MULTI_QUERY_N=3
# Nombre de tours de conversation transmis au réécriveur.
HISTORY_TURNS=4

# Compression contextuelle (étape 20)
# Vide = désactivé. embedding — mesurée à l'étape 20 et promue : Recall@context
# 0,814 contre une barre de 0,771 et un contrôle à 0,721, aucune régression par
# catégorie, refus 0,316 -> 0,211. Table dans le README.
COMPRESS_METHOD=embedding
# Profondeur du vivier envoyé au compresseur. L'étape 17 a mesuré
# Recall@20 == Recall@30 dans tous les viviers : 30 coûte 50 % d'embeddings en
# plus pour rien d'atteignable.
COMPRESS_CANDIDATES=20
# Caractères de texte de chunk que le contexte compressé peut porter, en-têtes
# exclus. Calé sur la taille mesurée du contexte top_k=5 actuel, pour qu'un
# vivier élargi coûte exactement le prompt d'aujourd'hui. Mesuré à l'étape 20
# sur les 38 questions répondables : le bloc de contexte entier fait 4 000
# caractères en p50, dont 312 d'en-têtes « [n] source — titre » ajoutés ensuite
# par build_context. Le budget compte le texte de chunk : 3 688, pas 4 000.
COMPRESS_BUDGET_CHARS=3688
# Exposant appliqué à la longueur d'une unité quand le compresseur dépense son
# budget : effective = score / len(unite) ** penalite. 0.0 = comportement de
# l'étape 20 à l'octet près, 1.0 = pertinence par caractère, négatif = favorise
# les unités longues (un bloc de code). Mesuré à l'étape 21 (0.5, 1.0, -0.5) :
# aucun ne passe la règle. 0.5 gagne sur `code` et perd `multi_doc` (0.812 ->
# 0.484) ; -0.5 fait l'inverse. Reste 0.0. Table dans le README.
COMPRESS_LENGTH_PENALTY=0.0

# Évaluation de la génération (étape 21)
# Le juge n'est délibérément pas GENERATION_MODEL : un modèle qui note sa propre
# sortie la surévalue, et le chiffre doit survivre aux étapes 22-25 qui changeront
# le générateur.
JUDGE_MODEL=gpt-4o
# Les embeddings de la pertinence (AnswerRelevancy) tournent en local (fastembed) :
# aucun modèle de la passerelle ne sert d'embeddings. Le changer rebase la pertinence.
JUDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Garde-fous (étape 22)
# v2 = prompt de l'étape 09 ; v3 = chaque entrée du contexte entre balises
# <entry>, et le texte balisé ne peut pas changer les règles. Reste v2 tant que
# la règle P de l'étape 22 n'est pas satisfaite — table dans le README.
PROMPT_VERSION=v2
# Écarte les chunks qui ressemblent à une injection (motifs de guard.py) avant
# de construire le contexte. Reste false tant que la règle D n'est pas satisfaite.
GUARD_DETECT=false

# Étape 23 — cache des réponses (Redis 8, docker compose up -d redis)
# Vide : pas de cache, aucune connexion. Les benchmarks ne passent jamais par le cache.
REDIS_URL=
REDIS_PORT=6379
# Filet de sécurité, en secondes (7 jours). La vraie invalidation : la réindexation vide le cache.
CACHE_TTL_S=604800
# Cosinus minimal pour servir une paraphrase. Absent : couche sémantique désactivée.
# Fixé seulement si la règle S passe (voir docs/superpowers/specs/2026-09-30-cache-design.md).
# CACHE_SEMANTIC_THRESHOLD=0.93
# Step 24 — local per-query traces. Enabling TRACE_PATH stores user queries.
# TRACE_CONTENT=true also stores prompts (including retrieved text) and responses.
# TRACE_PATH=data/processed/traces.jsonl
TRACE_CONTENT=false
# Configure both prices to calculate cost; leave unset when the gateway price is unknown.
# GENERATION_USD_PER_MTOK_INPUT=0.15
# GENERATION_USD_PER_MTOK_OUTPUT=0.60
